# Supabase (publishable keys — safe for client)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-side only — used to protect the /api/enrich endpoint
ENRICH_API_TOKEN=your-enrich-token

# Supabase server role key (server-only). Must NOT be published to clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================================
# Vercel Blob (for video thumbnail storage)
# =====================================================================
# Required for thumbnail uploads during video enrichment.
# Set this in your Vercel project dashboard or local .env.local:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#
# When you connect Vercel Blob to your project, Vercel automatically
# injects this variable into your deployment.
# =====================================================================
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token

# =====================================================================
# Upstash Redis (for distributed rate-limiting)
# =====================================================================
# When using Vercel, integrate Upstash via:
# https://vercel.com/integrations/upstash (auto-injects these variables)
#
# Otherwise, manually add from Upstash console → REST API:
#   - REST Endpoint → KV_REST_API_URL or UPSTASH_REDIS_REST_URL
#   - REST Token → KV_REST_API_TOKEN or UPSTASH_REDIS_REST_TOKEN
#
# The app supports both naming conventions:
#   KV_REST_API_URL / KV_REST_API_TOKEN  (Vercel KV)
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  (native Upstash SDK)
# =====================================================================
KV_REST_API_URL=https://<your-upstash-id>.upstash.io
KV_REST_API_TOKEN=<your-upstash-rest-token>

