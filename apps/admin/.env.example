# Supabase (publishable keys — safe for client)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-side only — used to protect the /api/enrich endpoint
ENRICH_API_TOKEN=your-enrich-token

# -----------------------------
# Upstash Redis (optional)
# Use for distributed/global rate-limiting. If not set, an in-memory per-instance
# rate limiter will be used as a fallback (not suitable for multi-instance).
# Obtain values from Upstash Redis -> REST API credentials.
# -----------------------------
UPSTASH_REDIS_REST_URL=https://<your-upstash-id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# -----------------------------
# Supabase server role key (server-only). Must NOT be published to clients.
# Add this to production only (Vercel/host secrets).
# -----------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
