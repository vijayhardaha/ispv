# Supabase (publishable keys — safe for client)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-side only — used to protect the /api/enrich endpoint
ENRICH_API_TOKEN=your-enrich-token

# Supabase server role key (server-only). Must NOT be published to clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================================
# Upstash Redis (for distributed rate-limiting)
# =====================================================================
# When using Vercel, integrate Upstash via:
# https://vercel.com/integrations/upstash (auto-injects these variables)
# 
# Otherwise, manually add from Upstash console → REST API:
#   - REST Endpoint → KV_REST_API_URL
#   - REST Token → KV_REST_API_TOKEN
# 
# See UPSTASH_SETUP.md for detailed instructions.
# =====================================================================
KV_REST_API_URL=https://<your-upstash-id>.upstash.io
KV_REST_API_TOKEN=<your-upstash-rest-token>

