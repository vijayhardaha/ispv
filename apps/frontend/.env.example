# Supabase (publishable keys — safe for client)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Google Analytics measurement ID (optional)
# Set to a real value like G-XXXXXXXXXX to enable GA in production
NEXT_PUBLIC_GA_ID=

# Admin app URL for public endpoints (submit, views)
# Default: https://admin-app.vercel.app
# For local dev: http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=https://admin-app.vercel.app
