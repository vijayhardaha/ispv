{
  "name": "reel-vault-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "chrome-extension"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:frontend": "bun run --filter @ispv/frontend dev",
    "dev:admin": "bun run --filter @ispv/admin dev",
    "build": "bun run --filter './apps/*' build",
    "lint": "bun run --filter './apps/*' lint",
    "lint:fix": "bun run --filter './apps/*' lint:fix",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check --log-level error .",
    "test": "bun run --filter './apps/*' test",
    "test:watch": "bun run --filter './apps/*' test:watch",
    "test:coverage": "bun run --filter './apps/*' test:coverage",
    "tsc": "bun run --filter './apps/*' tsc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/latinize": "^0.2.18",
    "@upstash/redis": "^1.38.0",
    "@vijayhardaha/dev-config": "^2.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "author": {
    "name": "Vijay Hardaha",
    "url": "https://github.com/vijayhardaha/"
  },
  "license": "MIT",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  }
}
