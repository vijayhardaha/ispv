{
  "name": "reel-vault-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "chrome-extension"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:frontend": "bun run --filter @reel-vault/frontend dev",
    "dev:admin": "bun run --filter @reel-vault/admin dev",
    "build": "bun run --filter './apps/*' build",
    "lint": "bun run --filter './apps/*' lint",
    "lint:fix": "bun run --filter './apps/*' lint:fix",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check --log-level error .",
    "tsc": "bun run --filter './apps/*' tsc"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@vijayhardaha/dev-config": "^2.2.0",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "author": {
    "name": "Vijay Hardaha",
    "url": "https://github.com/vijayhardaha/"
  },
  "license": "MIT",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
